        {
          "dataset": "clickstream",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH time_slots AS (\r\n  SELECT generate_series(\r\n    now() - interval '15 minutes', \r\n    now(), \r\n    '5 seconds'\r\n  )::timestamp as \"time\"\r\n)\r\nSELECT \r\n  ts.time,\r\n  COALESCE(count(re.event_id), 0)::float / 5 as \"rps\"\r\nFROM time_slots ts\r\nLEFT JOIN raw_events re \r\n  ON re.received_at >= ts.time \r\n  AND re.received_at < ts.time + interval '5 seconds'\r\nGROUP BY ts.time\r\nORDER BY ts.time ASC;\r\n",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "RPS",
      "type": "timeseries"
    },
