          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH time_slots AS (\r\n  SELECT generate_series(\r\n    now() - interval '1 hour', \r\n    now(), \r\n    '30 seconds'\r\n  )::timestamp as \"time\"\r\n)\r\nSELECT \r\n  ts.time as \"time\",\r\n  COALESCE(avg(extract(epoch from (re.received_at - re.created_at))) * 1000, 0) as \"avg_latency_ms\",\r\n  COALESCE(percentile_cont(0.95) WITHIN GROUP (ORDER BY extract(epoch from (re.received_at - re.created_at))) * 1000, 0) as \"p95_latency_ms\"\r\nFROM time_slots ts\r\nLEFT JOIN raw_events re ON re.received_at >= ts.time \r\n  AND re.received_at < ts.time + interval '30 seconds'\r\nGROUP BY ts.time\r\nORDER BY ts.time ASC;\r\n",
          "refId": "A",
