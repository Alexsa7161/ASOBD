{
  "uid": "ClickHouse_Table_Metrics",
  "title": "ClickHouse Table Metrics",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "timezone": "browser",
  "panels": [
    {
      "type": "stat",
      "title": "ClickHouse Alive",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [{ "expr": "up{job='clickhouse'}", "refId": "A" }],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "colorValue": [
          { "unit": "1", "color": "#4caf50", "value": 1 },
          { "unit": "0", "color": "#f44336", "value": 0 }
        ]
      },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 3 }
    },
    {
      "type": "stat",
      "title": "Rows in Table",
      "targets": [{ "expr": "ClickHouseAsyncMetrics_TotalRowsOfMergeTreeTablesSystem", "refId": "A" }],
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 3 }
    },
    {
      "type": "stat",
      "title": "Table Size (MB)",
      "targets": [{ "expr": "ClickHouseAsyncMetrics_TotalBytesOfMergeTreeTables / 1024 / 1024", "refId": "A" }],
      "gridPos": { "x": 0, "y": 3, "w": 6, "h": 3 }
    },
    {
      "type": "stat",
      "title": "Parts in Memory",
      "targets": [{ "expr": "ClickHouseMetrics_PartsInMemory", "refId": "A" }],
      "gridPos": { "x": 6, "y": 3, "w": 6, "h": 3 }
    },
    {
      "type": "timeseries",
      "title": "IO Pending / In Flight",
      "targets": [
        { "expr": "ClickHouseMetrics_IOUringPendingEvents", "refId": "A", "legendFormat": "Pending" },
        { "expr": "ClickHouseMetrics_IOUringInFlightEvents", "refId": "B", "legendFormat": "In Flight" }
      ],
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 4 }
    }
  ]
}
