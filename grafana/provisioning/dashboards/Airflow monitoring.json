          "rawSql": "SELECT \r\n  dag_id,\r\n  count(*) FILTER (WHERE state = 'success') as \"success\",\r\n  count(*) FILTER (WHERE state = 'failed') as \"failed\",\r\n  round(100.0 * count(*) FILTER (WHERE state = 'success')::numeric / nullif(count(*), 0), 1) as \"success_rate_percent\"\r\nFROM task_instance \r\nWHERE start_date >= now() - interval '24 hours'\r\nGROUP BY dag_id \r\nORDER BY failed DESC;\r\n",
