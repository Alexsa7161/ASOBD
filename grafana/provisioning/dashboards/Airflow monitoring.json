          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH time_slots AS (\r\n  SELECT generate_series(now() - interval '1 hour', now(), '1 minute')::timestamp as \"time\"\r\n)\r\nSELECT \r\n  ts.time as \"time\",\r\n  COALESCE(count(ti.task_id), 0)::float as \"airflow_db_writes_rps\"\r\nFROM time_slots ts\r\nLEFT JOIN task_instance ti ON ti.start_date >= ts.time AND ti.start_date < ts.time + interval '1 minute'\r\nGROUP BY ts.time\r\nORDER BY ts.time ASC;\r\n",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
