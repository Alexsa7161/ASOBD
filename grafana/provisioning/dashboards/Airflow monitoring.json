          "rawQuery": true,
          "rawSql": "WITH time_slots AS (\r\n  SELECT generate_series(now() - interval '1 hour', now(), '30 seconds')::timestamp as \"time\"\r\n)\r\nSELECT \r\n  ts.time as \"time\",\r\n  COALESCE(avg(extract(epoch from (ti.end_date - ti.start_date))) * 1000, 0) as \"avg_task_latency_ms\"\r\nFROM time_slots ts\r\nLEFT JOIN task_instance ti ON ti.start_date >= ts.time AND ti.start_date < ts.time + interval '30 seconds'\r\n  AND ti.state = 'success'\r\nGROUP BY ts.time\r\nORDER BY ts.time ASC;\r\n",
