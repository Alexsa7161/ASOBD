{
  "info": {
    "name": "Clickstream API Tests",
    "_postman_id": "clickstream-tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check API",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": [""]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('API is running', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql('ok');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Send Events (Single)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "[\n  {\n    \"event_id\": \"11111111-1111-1111-1111-111111111111\",\n    \"type\": \"click\",\n    \"created_at\": \"2026-01-08T02:00:00Z\",\n    \"received_at\": \"2026-01-08T02:00:00Z\",\n    \"session_id\": \"test-session-123\",\n    \"user_id\": 123,\n    \"ip\": \"127.0.0.1\",\n    \"url\": \"http://localhost:8081\",\n    \"referrer\": \"\",\n    \"device_type\": \"web\",\n    \"user_agent\": \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36\",\n    \"event_title\": \"Test Button\",\n    \"element_id\": \"test-btn-1\",\n    \"x\": 100,\n    \"y\": 200\n  }\n]",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:8080/events",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["events"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Events processed', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql('ok');",
              "    pm.expect(jsonData.count).to.eql(1);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get HTML Page",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8081/page",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8081",
          "path": [""]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
