# ======================
# GENERATOR
# ======================
EVENT_COUNT=200000
DELAY_MS=5

# ======================
# CSV SOURCE
# ======================
CSV_ENABLED=true
CSV_PATH=/data/events.csv

# ======================
# HTTP SOURCE
# ======================
HTTP_ENABLED=true
HTTP_ENDPOINT=http://api:8000/events
HTTP_BATCH_SIZE=500

# ======================
# BROKER SOURCE
# ======================
BROKER_ENABLED=true
RABBITMQ_HOST=rabbitmq
RABBITMQ_QUEUE=events

